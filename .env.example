DJANGO_SUPERUSER_USERNAME=senpai
DJANGO_SUPERUSER_PASSWORD="{{ superuser_password }}"
DJANGO_SECRET_KEY="{{ django_secret_key }}"
DEBUG=False
ALLOWED_HOSTS="localhost,127.0.0.1,{{ website_main_host }}"
CSRF_TRUSTED_ORIGINS=https://"{{ website_main_host }}"
SQLITE_PATH="/data/db.sqlite3"
LEMMY_INSTANCE="{{ bot_instance_url }}"
LEMMY_USERNAME="{{ bot_username }}"
LEMMY_PASSWORD="{{ bot_password }}"
FEDI_ANIME_AWARDS_URL="{{ website_main_url }}"
CONTACT_URL="{{ contact_url }}"
CONTACT_USERNAME="{{ contact_name }}"
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
